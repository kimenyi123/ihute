# Copy to /var/www/ihute-frontend-dev/.env on the server (dev.ihute.rw)
# Java WAR context: Trading_dev on Tomcat :8080
# Nginx must proxy https://dev.ihute.rw/Trading_dev/ -> http://127.0.0.1:8080/Trading_dev/

# ==================== GIT PULL (Bitbucket on server) ====================
# Create App Password: Bitbucket → Personal settings → App passwords (Repositories: Read)
BITBUCKET_GIT_USER=your_bitbucket_username
BITBUCKET_APP_PASSWORD=

# Alternative: SSH deploy key — run scripts/setup-bitbucket-deploy-key.sh, add pubkey to repo Access keys
# BITBUCKET_DEPLOY_KEY=/root/.ssh/bitbucket_ihute_deploy

# ==================== NEXT.JS APP ====================
PORT=3007
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_URL=https://dev.ihute.rw

# ==================== BACKEND API (Trading_dev) ====================
# Server-side (Next.js API routes proxy to Java — use localhost, fast)
JAVA_BACKEND_BASE=http://127.0.0.1:8080/Trading_dev
BACKEND_URL=http://127.0.0.1:8080/Trading_dev

# Browser / client (same host as dev site — nginx forwards to Tomcat)
NEXT_PUBLIC_API_BASE=https://dev.ihute.rw/Trading_dev
NEXT_PUBLIC_API_URL=https://dev.ihute.rw/Trading_dev
NEXT_PUBLIC_JAVA_BACKEND_BASE=https://dev.ihute.rw/Trading_dev

# Explicit servlet URLs (browser-reachable via dev.ihute.rw nginx)
JAVA_AUTH_URL=https://dev.ihute.rw/Trading_dev/Kaos/user-auth
JAVA_ORDERS_URL=https://dev.ihute.rw/Trading_dev/OrdersServlet
JAVA_SERVLET_URL=https://dev.ihute.rw/Trading_dev/Kaos/OrdersServlet
JAVA_FETCH_SUGGESTIONS_URL=https://dev.ihute.rw/Trading_dev/Kaos/fetchSuggestions
JAVA_SELLER_ORDERS_URL=https://dev.ihute.rw/Trading_dev/Kaos/SellerOrdersServlet
JAVA_SUPPLIER_URL=https://dev.ihute.rw/Trading_dev/SupplierServlet
JAVA_DELIVERY_URL=https://dev.ihute.rw/Trading_dev/DeliveryServlet
JAVA_SUPPLIERS_URL=https://dev.ihute.rw/Trading_dev/InsertSuppliers
JAVA_SHOP_WITH_ME_URL=https://dev.ihute.rw/Trading_dev/shop_with_me

# ==================== AUTH / LINKS ====================
ISHYIGA_RESET_PASSWORD_URL=https://dev.ihute.rw/reset-password
ISHYIGA_LOGIN_URL=https://dev.ihute.rw/login
NEXT_PUBLIC_MOMO_USSD_PREFIX=*182*8*1*

# ==================== UMUSADA ====================
UMUSADA_INVOICE_SUBMIT_URL=https://bank-apis.umusada.com/api/v1/invoice/submit
UMUSADA_USERNAME=umusada.dev@gmail.com
UMUSADA_PASSWORD=Admin@123

# ==================== IMAGE UPLOADS ====================
IHUTE_PUBLIC_DIR=/var/www/ihute-frontend-dev/public
SHOP_UPLOADS_DIR=/var/www/ihute-frontend-dev/public/uploads/shops
PRODUCT_UPLOADS_DIR=/var/www/ihute-frontend-dev/public/uploads/products

# ==================== LOCATION / FEATURES ====================
NEXT_PUBLIC_LOCATIONIQ_API_KEY=pk.cc7d01c84e9813f009525ca58b8e50ad
NEXT_PUBLIC_ENABLE_ENHANCED_LOCATION=true
NEXT_PUBLIC_ENABLE_GEOCODING_CACHE=true
NEXT_PUBLIC_CACHE_TTL_DAYS=90
NEXT_PUBLIC_DEFAULT_SEARCH_RADIUS=50
NEXT_PUBLIC_MAX_SEARCH_RADIUS=500
NEXT_PUBLIC_DEFAULT_RESULT_LIMIT=20
NEXT_PUBLIC_MAX_RESULT_LIMIT=100
NEXT_PUBLIC_RWANDA_MIN_LAT=-2.9
NEXT_PUBLIC_RWANDA_MAX_LAT=-1.0
NEXT_PUBLIC_RWANDA_MIN_LNG=28.8
NEXT_PUBLIC_RWANDA_MAX_LNG=31.0
NEXT_PUBLIC_LOCATIONIQ_RATE_LIMIT=1000
NEXT_PUBLIC_LOCATIONIQ_TIMEOUT=10000
NEXT_PUBLIC_DEBUG_LOCATION=false
NEXT_PUBLIC_SHOW_CACHE_STATS=true
