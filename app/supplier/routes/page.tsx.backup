'use client';

import dynamic from 'next/dynamic';
import { Suspense } from 'react';

// Dynamically import the actual component with no SSR
const SupplierRoutesContent = dynamic(
  () => import('./SupplierRoutesContent'),
  { 
    ssr: false,
    loading: () => <div>Loading routes...</div>
  }
);

export default function SupplierRoutesPage() {
  return (
    <Suspense fallback={<div>Loading...</div>}>
      <SupplierRoutesContent />
    </Suspense>
  );
}
