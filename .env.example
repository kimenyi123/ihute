# Public browser origin for WhatsApp / SMS links (Rx images, track-order).
# Prefer this over NEXT_PUBLIC_SITE_URL when local SITE_URL is http://localhost:3000 —
# localhost hosts are ignored and we fall back to https://ihute.rw.
# NEXT_PUBLIC_PUBLIC_BASE_URL=https://ihute.rw

MONGO_URI=
MONGO_DATABASE=ihute_ops
MONGO_COLLECTION=stock_sync_events

# Optional if you prefer Atlas Data API instead of MONGO_URI:
# MONGO_DATA_API_URL=
# MONGO_DATA_API_KEY=
# MONGO_DATA_SOURCE=

# Optional API secret for non-browser access to /api/stock-sync/logs
STOCK_SYNC_LOGS_API_SECRET=

# Backend URL used for admin verification in stock-sync logs API
BACKEND_URL=http://localhost:8080/Trading
# Preferred for Grandma Search (and other Java proxies). First complete value wins:
# JAVA_BACKEND_BASE → BACKEND_URL → NEXT_PUBLIC_API_URL (Trading-like) → defaults.
# JAVA_BACKEND_BASE=http://localhost:8082/Trading
# Grandma Search: GET {JAVA_BACKEND_BASE}/grandma/search  (not fetchSuggestions, not Next.js MySQL)

# Shop logo uploads (beta/production) — absolute path to Next.js public folder
# IHUTE_PUBLIC_DIR=/var/www/ihute-frontend_beta/public
# Optional: shop images only (defaults to $IHUTE_PUBLIC_DIR/uploads/shops)
# SHOP_UPLOADS_DIR=/var/www/ihute-frontend_beta/public/uploads/shops

# Dev server (dev.ihute.rw + Trading_dev WAR) — see .env.dev.example for full file

# Optional index TTL in seconds (e.g. 7776000 = 90 days)
# STOCK_SYNC_LOG_TTL_SECONDS=

# --- RRA EBM / VSDC (lib/ebm) — never commit real security_key ---
# EBM / RRA VSDC (required for seller Approve EBM Invoice)
# EBM_SECURITY_KEY=
# EBM_BASE_URL=https://ishyiga.com
# EBM_INVOICE_PATH=/vsdc/post_receipt_vsdc_rite_convert_Json
# EBM_REGISTER_PATH=/vsdc/post_parameter_vsdc_Json
# EBM_COMPANY_TIN=
# EBM_TIMEOUT_MS=30000
# EBM_RETRY_ATTEMPTS=3

# --- MOH eRx (FHIR) — lib/erx, never commit real credentials ---
# MOH_ERX_BASE_URL=http://197.243.24.138:5001/shr
# MOH_ERX_USERNAME=
# MOH_ERX_PASSWORD=
# MOH_ERX_TIMEOUT_MS=15000
# Optional GET to verify registration before invoice:
# EBM_REGISTER_CHECK_PATH=/vsdc/get_parameter_vsdc_Json
# Optional item sync before invoice (some VSDC servers):
# EBM_ITEM_SYNC_PATH=/vsdc/Send_Vsdc_item_lite_json
# EBM_DEFAULT_ITEM_CLASS=
# Auto-register company on VSDC when not registered (default true):
# EBM_AUTO_REGISTER=true
# Registration payload fields (required when auto-register runs):
# EBM_BRANCH_ID=
# EBM_DEVICE_SERIAL=
# EBM_TAXPAYER_NAME=
# EBM_BUSINESS_ACTIVITY=
# EBM_BRANCH_STATUS=01
# EBM_PROVINCE=
# EBM_DISTRICT=
# EBM_SECTOR=
# EBM_LOCATION=
# EBM_HQ_YN=Y
# EBM_MANAGER_NAME=
# EBM_MANAGER_PHONE=
# EBM_MANAGER_EMAIL=
# EBM_DEFAULT_USERNAME=
# Auto-fiscalize when order is delivered (default OFF — seller approves on dashboard):
# EBM_AUTO_FISCALIZE=false
# EBM_PROXY_URL=https://shop.ihute.rw/api/ebm/proxy
# EBM_PROXY_SECRET=
# ONBOARDING_MYSQL_CONNECT_TIMEOUT_MS=8000

# Grandma/Umuriro Order Persistence — REQUIRED for Grandma Quick Shop
# All Grandma/Umuriro orders MUST be saved to the database via ONBOARDING_MYSQL_*.
# Set these variables on your server (or use fallback GQ_MYSQL_*, MYSQL_*, DB_URL+DB_USER+DB_PASS).
# Point at the SAME schema as the Java Tomcat backend (Java dbName / ISHYIGA_DB_NAME).
# Do not hardcode a Kaos schema name in app code.
# Existing server .env files are not updated by git pull — add missing keys by hand.
# This file is documentation only; Next.js does not load .env.example at runtime.
# REQUIRED: Set all four of these for Grandma order persistence
ONBOARDING_MYSQL_HOST=127.0.0.1
ONBOARDING_MYSQL_PORT=3306
ONBOARDING_MYSQL_USER=your_mysql_user
ONBOARDING_MYSQL_PASSWORD="your_password_if_it_contains_hash_characters"
ONBOARDING_MYSQL_DATABASE=your_kaos_database
# Optional: custom connection timeout (milliseconds)
# ONBOARDING_MYSQL_CONNECT_TIMEOUT_MS=8000
# Optional dedicated EBM DB override (else uses ONBOARDING_MYSQL_* above):
# EBM_MYSQL_HOST=127.0.0.1
# EBM_MYSQL_USER=your_mysql_user
# EBM_MYSQL_PASSWORD=
# EBM_MYSQL_DATABASE=your_kaos_database

# Signed table-join QR tokens (must match kaos TABLE_JOIN_TOKEN_SECRET)
# TABLE_JOIN_TOKEN_SECRET=
# TABLE_JOIN_TOKEN_TTL_SECONDS=86400

# Saba / ebm.rw fiscal invoice integration (server-only)
# PHP/XAMPP: GQ_EBM_BASE_URL=http://localhost/EBM
# Order / marketplace DB: same host+schema as kaos MySQLConnector (never hardcode passwords).
# Prefer GQ_MYSQL_* OR ONBOARDING_MYSQL_* OR MYSQL_*.
# Or mirror kaos Tomcat EnvLoader: DB_URL=jdbc:mysql://host:3306/<kaos_database>?...  + DB_USER + DB_PASS
# Must match Kaos (GET /Trading/Kaos/deployment-hint → databaseHost + database).
# Quote passwords that contain # (dotenv treats unquoted # as a comment): GQ_MYSQL_PASSWORD="..."
# XAMPP root with no password: GQ_MYSQL_PASSWORD=
# GQ_MYSQL_HOST=
# GQ_MYSQL_USER=
# GQ_MYSQL_PASSWORD=
# GQ_MYSQL_DATABASE=
# NIKI catalog schema for prescription-review (default niki):
# NIKI_MYSQL_DATABASE=niki
# DB_URL=jdbc:mysql://127.0.0.1:3306/your_kaos_database?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USER=
# DB_PASS=
GQ_EBM_BASE_URL=https://ebm.rw
# STAGING: use a dedicated key pair that matches ebm GQ_API_KEYS — never ship ihute-dev to staging.
GQ_EBM_KEY_ID=
GQ_EBM_SECRET=
# Optional aliases for inbound ebm→IHUTE webhooks (defaults to GQ_EBM_* above)
# GQ_WEBHOOK_KEY_ID=
# GQ_WEBHOOK_SECRET=
GQ_OTP_SECRET=
# GQ_CLOCK_SKEW_SECONDS=300

# Configure either Twilio or SMS_WEBHOOK_URL for invoice OTP (staging/production).
# Local only: SMS_DEV_LOG=1 (OTP logged + returned as devCode) — do NOT leave this on for staging OTP tests.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_SECRET=
# SMS_DEV_LOG=1
