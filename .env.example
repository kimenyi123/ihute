MONGO_URI=
MONGO_DATABASE=ihute_ops
MONGO_COLLECTION=stock_sync_events

# Optional if you prefer Atlas Data API instead of MONGO_URI:
# MONGO_DATA_API_URL=
# MONGO_DATA_API_KEY=
# MONGO_DATA_SOURCE=

# Optional API secret for non-browser access to /api/stock-sync/logs
STOCK_SYNC_LOGS_API_SECRET=

# Backend URL used for admin verification in stock-sync logs API
BACKEND_URL=http://localhost:8080/Trading

# Shop logo uploads (beta/production) — absolute path to Next.js public folder
# IHUTE_PUBLIC_DIR=/var/www/ihute-frontend_beta/public
# Optional: shop images only (defaults to $IHUTE_PUBLIC_DIR/uploads/shops)
# SHOP_UPLOADS_DIR=/var/www/ihute-frontend_beta/public/uploads/shops

# Dev server (dev.ihute.rw + Trading_dev WAR) — see .env.dev.example for full file

# Optional index TTL in seconds (e.g. 7776000 = 90 days)
# STOCK_SYNC_LOG_TTL_SECONDS=
