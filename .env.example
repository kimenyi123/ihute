# .env.example (SAFE TO COMMIT)
# Copy to .env or .env.local — all backend API URLs come from here (no hardcoded URLs in code).

# ==================== BACKEND API (use .env or .env.local) ====================
# One base is enough; all backend URLs are derived from these (see lib/backend-config.ts).
# For production: set NEXT_PUBLIC_API_URL and optionally NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_API_BASE=http://localhost:8081/Trading
NEXT_PUBLIC_API_URL=http://localhost:8081/Trading
# Site root for order/track links (defaults from NEXT_PUBLIC_API_URL if unset)
# NEXT_PUBLIC_SITE_URL=https://ihute.rw

# Optional: override specific servlets (defaults built from base above)
# JAVA_AUTH_URL=http://localhost:8081/Trading/Kaos/user-auth
# OrdersServlet lives under Kaos (not .../Trading/OrdersServlet — that 404s / connection errors).
# JAVA_ORDERS_URL=http://localhost:8081/Trading/Kaos/OrdersServlet
# JAVA_SERVLET_URL=http://localhost:8081/Trading/Kaos/OrdersServlet
# JAVA_INSERT_URL=http://localhost:8081/Trading/Kaos/insertrekizisiyo
# JAVA_FETCH_SUGGESTIONS_URL=http://localhost:8081/Trading/Kaos/fetchSuggestions
# Backend (fetchSuggestions) must always search Redis first; when no data, search DB. No frontend param.
# For supplier-scoped search (e.g. "Products from IWACU BAR" + term): backend must use Redis key supplier_<account> first. See docs/backend-redis-search.md.
# JAVA_SELLER_ORDERS_URL=http://localhost:8081/Trading/Kaos/SellerOrdersServlet
# JAVA_SUPPLIER_URL=http://localhost:8081/Trading/SupplierServlet
# JAVA_DELIVERY_URL=http://localhost:8081/Trading/DeliveryServlet
# JAVA_POST_ORDERS_URL=http://localhost:8081/Trading/post_orders
# Account profile (account_signup): GET by email/account, PUT to update. See docs/backend-account-profile-api.md.
# JAVA_ACCOUNT_PROFILE_URL=http://localhost:8081/Trading/Api/AccountProfile

# --- Guest pool (Continue as guest): auto-insert guest_pool@ihute.rw into account_signup when missing ---
# Same MySQL as your Java app. If unset, use scripts/seed-guest-buyer-account.sql manually.
# MYSQL_HOST=localhost
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=chaos_test
# GUEST_POOL_AUTO_INSERT=true
# Optional: if PWD column is NOT NULL and rejects '', set e.g. GUEST_POOL_DB_PWD_PLACEHOLDER=-
# DEFAULT_GUEST_ISHYIGA_ACCOUNT=IHUTE_GUEST
# GUEST_POOL_EMAIL=guest_pool@ihute.rw
# JAVA_BACKEND_BASE=http://localhost:8081/Trading
# If you get 404 from all backend URLs, your Tomcat context may differ (e.g. kaos.war → use http://localhost:8080/kaos).

# For production, set e.g. NEXT_PUBLIC_API_URL=https://ihute.rw/Trading (and JAVA_* if needed).

# Optional: proxy timeouts (ms). Excel import uses 5 min default for large files.
# SUPPLIER_STOCK_IMPORT_TIMEOUT_MS=300000
# PROXY_TIMEOUT_MS=12000

# Redis cache TTL (seconds) for API responses. Next.js checks Redis first, then backend (DB).
# REDIS_CACHE_SUGGESTIONS_TTL_SEC=300
# REDIS_CACHE_DATA_TTL_SEC=120

# MoMo USSD prefix for QR/dial string. Default *182*1*1* (format: *182*1*1*momocode*amount#). Use *182*8*1* if different.
# NEXT_PUBLIC_MOMO_USSD_PREFIX=*182*1*1*

# ==================== PRODUCTION / WAR DEPLOYMENT ====================
# On the server where Next.js runs (e.g. Vercel, Node, or same host as war), set the Java backend URL
# so request-loan, orders, and other API routes can reach your deployed Java app.
# Example if your war is at https://ihute.rw/Trading_beta:
#   JAVA_BACKEND_BASE=https://ihute.rw/Trading_beta
#   NEXT_PUBLIC_API_URL=https://ihute.rw/Trading_beta
# If unset, the app defaults to https://ihute.rw/Trading.

# ==================== UMUSADA (REQUEST LOAN + EXCEL UPLOAD) ====================
# For request-loan-with-details (buyer financing): login to Umusada auth, then submit invoice.
UMUSADA_USERNAME=your-umusada-email@example.com
UMUSADA_PASSWORD=your-umusada-password
# Or reuse Excel credentials:
# Shared credentials: request-loan and Excel upload use the same login.
# If you see 401 "Wrong username or password" from Umusada, set these to a valid Umusada account.
UMUSADA_EXCEL_EMAIL=your-umusada-email@example.com
UMUSADA_EXCEL_PASSWORD=your-umusada-password
# UMUSADA_AUTH_BASE=https://umusada-master.umusada.com/umusada-master-service
# UMUSADA_BANK_API=https://bank-apis.umusada.com/api/v1
# If bank returns "No static resource api/v1/invoice/submit", set full invoice submit URL (ask Umusada for correct endpoint):
# UMUSADA_INVOICE_SUBMIT_URL=https://bank-apis.umusada.com/your-actual-path/invoice/submit
# Optional: if invoice API expects different auth header/scheme (default: Authorization + Bearer <token>)
# UMUSADA_INVOICE_AUTH_HEADER=Authorization
# UMUSADA_INVOICE_AUTH_SCHEME=Bearer
# JAVA_BUSINESS_API_URL=https://your-backend/api/business  (optional; default: getBackendBase() + /api/business — set if business API is elsewhere)
# Optional: pre-auth token (skips OTP flow)
# UMUSADA_EXCEL_TOKEN=your-token
# Set true to proxy to kaos; false/unset = Next.js login (same as request-loan)
UMUSADA_EXCEL_USE_JAVA_BACKEND=false
# JAVA_UMUSADA_EXCEL_URL=http://localhost:8081/Trading/UmusadaExcelServlet




# Environment Variables for Enhanced Location Search

# ==================== LOCATIONIQ API ====================
# Get your free API key from: https://locationiq.com/
# Free tier: 10,000 requests/day
NEXT_PUBLIC_LOCATIONIQ_API_KEY=pk.cc7d01c84e9813f009525ca58b8e50ad

# ==================== JAVA BACKEND ====================
# Your Java backend base URL
JAVA_BASE_URL=https://ihute.rw/Trading

# For production, use your deployed backend URL:
# JAVA_BASE_URL=https://your-backend-domain.com/Trading

# ==================== FEATURE FLAGS ====================
# Enable enhanced location search (set to 'false' to use old system)
NEXT_PUBLIC_ENABLE_ENHANCED_LOCATION=true

# Enable geocoding cache (recommended)
NEXT_PUBLIC_ENABLE_GEOCODING_CACHE=true

# Cache TTL in days (default: 90)
NEXT_PUBLIC_CACHE_TTL_DAYS=90

# ==================== SEARCH DEFAULTS ====================
# Default search radius in kilometers
NEXT_PUBLIC_DEFAULT_SEARCH_RADIUS=50

# Maximum search radius allowed
NEXT_PUBLIC_MAX_SEARCH_RADIUS=500

# Default result limit
NEXT_PUBLIC_DEFAULT_RESULT_LIMIT=20

# Maximum result limit allowed
NEXT_PUBLIC_MAX_RESULT_LIMIT=100

# ==================== RWANDA BOUNDARIES ====================
# These define valid coordinate ranges for Rwanda
NEXT_PUBLIC_RWANDA_MIN_LAT=-2.9
NEXT_PUBLIC_RWANDA_MAX_LAT=-1.0
NEXT_PUBLIC_RWANDA_MIN_LNG=28.8
NEXT_PUBLIC_RWANDA_MAX_LNG=31.0

# ==================== API RATE LIMITING ====================
# Milliseconds between LocationIQ API requests
NEXT_PUBLIC_LOCATIONIQ_RATE_LIMIT=1000

# API request timeout in milliseconds
NEXT_PUBLIC_LOCATIONIQ_TIMEOUT=10000

# ==================== DEBUGGING ====================
# Enable debug logging in browser console
NEXT_PUBLIC_DEBUG_LOCATION=false

# Show cache statistics in UI
NEXT_PUBLIC_SHOW_CACHE_STATS=true

# ==================== NOTES ====================
# 
# LocationIQ Free Tier Limits:
# - 10,000 requests per day
# - 2 requests per second
# - Geocoding & reverse geocoding included
# 
# To increase limits, upgrade at: https://locationiq.com/pricing
# 
# Cache Strategy:
# - First request: Uses LocationIQ API (slow)
# - Subsequent requests: Uses cached coordinates (instant)
# - Cache persists for 90 days (configurable)
# - Cache stored in browser localStorage
# 
# Backend Requirements:
# - Java backend must implement getNearestSuppliers action
# - See enhanced-java-methods.java for implementation
# - Backend calculates exact Haversine distances
# - Backend checks ALL suppliers (no grid limitations)
